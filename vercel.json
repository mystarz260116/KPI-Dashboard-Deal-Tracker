{
  "crons": [
    {
      "path": "/api/deals/notifications-cleanup",
      "schedule": "0 18 * * *"
    }
  ],
  "rewrites": [
    { "source": "/api/customers/(.*)", "destination": "/api/customers?path=$1" },
    { "source": "/api/deals/(.*)", "destination": "/api/deals?path=$1" },
    { "source": "/api/import/sales/(.*)", "destination": "/api/import?path=sales/$1" },
    { "source": "/api/kpi/(.*)", "destination": "/api/kpi?path=$1" },
    { "source": "/api/merge/(.*)", "destination": "/api/merge?path=$1" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/@vite/(.*)", "destination": "/@vite/$1" },
    { "source": "/@react-refresh", "destination": "/@react-refresh" },
    { "source": "/@id/(.*)", "destination": "/@id/$1" },
    { "source": "/@fs/(.*)", "destination": "/@fs/$1" },
    { "source": "/src/(.*)", "destination": "/src/$1" },
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/node_modules/(.*)", "destination": "/node_modules/$1" },
    { "source": "/favicon.ico", "destination": "/favicon.ico" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
